CMakeLists.txt.*

#for vim editor
*.swp

#for clangd with YCM on vim
.cache/
compile_commands.json

#for build dir
build/

#for ${default} where youtube-dl keeps getting downloaded to.
${default}/

# root Rust workspace
/target/

# the C++ reference tree builds in place (legacy/build_windows.ps1 writes to
# legacy/BUILD); nothing produced there is committed
/legacy/build/
/legacy/BUILD/
/legacy/src/build/

# python bytecode from the capture tooling and its tests
__pycache__/
*.pyc

# translations are generated from the .ts sources at build time; a stale binary
# catalogue must not be committed silently
*.qm

# the size report is produced by CI, not tracked
size-report.txt

# xtask is its own workspace and has no dependencies, so its lock file is noise
/xtask/Cargo.lock
/xtask/target/
